{
  "name": "professional-website",
  "type": "module",
  "version": "1.0.0",
  "description": "A modern, performant professional website built with Astro and Tailwind CSS",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint . --ext .astro,.ts,.js",
    "format": "prettier --write .",
    "check": "astro check",
    "prepare": "husky"
  },
  "dependencies": {
    "astro": "^4.16.0",
    "@astrojs/check": "^0.9.0",
    "@astrojs/tailwind": "^5.1.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "prettier-plugin-astro": "^0.14.0",
    "prettier-plugin-tailwindcss": "^0.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "lint-staged": {
    "*.{astro,ts,js,json,md,css}": ["prettier --write", "eslint --fix"]
  }
}